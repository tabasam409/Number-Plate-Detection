import cv2

# Load the pre-trained Haar Cascade classifier for license plate detection
plate_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_russian_plate_number.xml')

# Start capturing video from the default camera (index 0)
cap = cv2.VideoCapture(0)

while True: #This line starts an infinite loop that will capture and process frames from the video stream.
    # Capture frame-by-frame
    #This line captures a frame from the video stream. 
    # The ret variable will be True if the frame was captured successfully, and False otherwise.
    #  The frame variable will contain the captured frame

    ret, frame = cap.read()

    # Convert the frame to grayscale for license plate detection
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    # Detect license plates in the frame
    plates = plate_cascade.detectMultiScale(gray, scaleFactor=1.1, minNeighbors=5, minSize=(80, 80))

    # Draw rectangles around detected license plates
    for (x, y, w, h) in plates:
        cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 0), 2)

    # Display the resulting frame
    cv2.imshow('License Plate Detection', frame)

    # Break the loop when 'q' is pressed
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

# Release the capture and close all OpenCV windows
cap.release()
cv2.destroyAllWindows()